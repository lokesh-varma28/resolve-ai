# ResolveAI AI Orchestrator Environment Configuration
# LLM Provider Configuration: 'gemini' (default) or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional OpenAI Fallback / Compatibility Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pipeline Execution Mode: 'hybrid', 'deterministic_only', or 'llm_only'
EXECUTION_MODE=hybrid
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_TOOL_CALLS=4
